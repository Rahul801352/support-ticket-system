						"url": {
							"raw": "{{baseUrl}}/tickets?status=open&sort=created_at",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"tickets"
							],
							"query": [
								{
									"key": "status",
									"value": "open"
								},
								{
									"key": "sort",
									"value": "created_at"
								}
							]
						}
					}
				},
				{
					"name": "2.3 Get Ticket by ID",
